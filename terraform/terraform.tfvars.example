# Copy this file to terraform.tfvars and update it.
# terraform.tfvars is gitignored. This example is not.

aws_region   = "us-east-1"
project_name = "roboshop"
environment  = "dev"

vpc_cidr                = "10.0.0.0/16"
public_subnet_cidr      = "10.0.1.0/24"
private_app_subnet_cidr = "10.0.10.0/24"
private_db_subnet_cidr  = "10.0.20.0/24"
availability_zone       = "us-east-1a"

# Replace with your own address. 0.0.0.0/0 is rejected.
# curl -fsS ifconfig.me
admin_cidr = ["203.0.113.10/32"]

# ssh-keygen -t ed25519 -f ~/.ssh/roboshop-key -C "roboshop"
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIExampleKeyReplaceMe roboshop"

app_instance_type      = "t3.micro"
db_instance_type       = "t3.small"
shipping_instance_type = "t3.small"

# VPC flow logs are off by default. Set true if you want the audit trail.
enable_flow_logs = false

private_domain = "roboshop.internal"
mysql_app_user = "shipping"
rabbitmq_user  = "roboshop"

# Passwords are not set here. Terraform writes random values to SSM.

tags = {
  Project     = "RoboShop"
  Environment = "Development"
  ManagedBy   = "Terraform"
  CostCenter  = "Engineering"
}
